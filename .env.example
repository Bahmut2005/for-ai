# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use the docker-compose default below for local dev.
DATABASE_URL="postgresql://postgres:password@localhost:5432/omniverse_wheel"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── OAuth Providers (Phase 5) ─────────────────────────────────────────────────
# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Spin Security ─────────────────────────────────────────────────────────────
# Signs short-lived winner tokens so the client cannot substitute a different result.
# Generate with: openssl rand -base64 32
SPIN_JWT_SECRET=""
# How long the winner token stays valid (in seconds). Should be slightly > animation duration.
SPIN_JWT_TTL_SECONDS="15"

# ── External Data APIs (Phase 4) ─────────────────────────────────────────────
# TMDB — register at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
TMDB_API_READ_ACCESS_TOKEN=""

# AniList — free public GraphQL API, no key required for basic queries
ANILIST_API_URL="https://graphql.anilist.co"

# Jikan (MyAnimeList unofficial) — free, no key required
JIKAN_API_URL="https://api.jikan.moe/v4"

# Kitsu — free public API
KITSU_API_URL="https://kitsu.io/api/edge"

# TVMaze — free public API, no key required
TVMAZE_API_URL="https://api.tvmaze.com"

# Open Library — free public API
OPENLIBRARY_API_URL="https://openlibrary.org"

# Google Books — optional, requires API key
GOOGLE_BOOKS_API_KEY=""

# Comic Vine — optional, requires API key from https://comicvine.gamespot.com/api/
COMIC_VINE_API_KEY=""

# IGDB (games) — requires Twitch app credentials at https://dev.twitch.tv/
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Whether to allow adult content to be toggled on by users
ENABLE_ADULT_CONTENT="false"
# Whether the import wizard is available
ENABLE_IMPORT="true"
# Number of segments shown on the visual wheel
MAX_WHEEL_SEGMENTS="24"
# Show the admin panel link in the navbar for admin-role users
ENABLE_ADMIN="true"
